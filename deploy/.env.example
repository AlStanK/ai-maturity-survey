# Скопіювати в .env і замінити паролі на власні.
# Згенерувати пароль: openssl rand -base64 24

POSTGRES_DB=aimaturity
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ЗАМІНИТИ_пароль_власника_бази
AUTHENTICATOR_PASSWORD=ЗАМІНИТИ_пароль_ролі_authenticator

# Звідки дозволено звертатися до API. Через кому, без пробілів.
CORS_ORIGINS=https://alstank.github.io

# Домен API — для профілю tls
API_DOMAIN=api.example.com

API_PORT=3000
METABASE_PORT=3001
